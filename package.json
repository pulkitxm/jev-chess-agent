{
  "name": "jev-chess-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "build": "node scripts/build.js",
    "test": "node --test",
    "choose": "node --env-file-if-exists=.env src/cli.js",
    "play": "node --env-file-if-exists=.env src/run.js",
    "demo": "node --env-file-if-exists=.env src/run.js --demo",
    "record:4k": "node --env-file-if-exists=.env src/run.js --4k",
    "attempt:win": "node scripts/attempt-win.js",
    "play:advanced": "node --env-file-if-exists=.env src/run.js --opponent advanced --4k --strategy development",
    "play:advanced:assisted": "node --env-file-if-exists=.env src/run.js --opponent advanced --4k --strategy engine-review",
    "play:beginner": "node --env-file-if-exists=.env src/run.js --opponent beginner --4k --strategy development",
    "session:setup": "python3 -m venv data/session-tools && data/session-tools/bin/pip install -r scripts/session-requirements.txt",
    "session:export": "data/session-tools/bin/python scripts/export-session.py"
  },
  "dependencies": {
    "chess.js": "1.4.0",
    "ffmpeg-static": "^5.3.0",
    "playwright": "^1.63.0"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "jsdom": "26.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
